<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HushWake" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/brand_window</item>
        <item name="android:navigationBarColor">@color/brand_window</item>
        <item name="android:colorAccent">@color/brand_amber</item>
        <item name="android:alertDialogTheme">@style/Theme.HushWake.Dialog</item>
        <item name="android:windowBackground">@color/brand_window</item>
        <item name="android:textColorPrimary">#F6F7FA</item>
        <item name="android:textColorSecondary">#8E9BAE</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.HushWake.Starting" parent="Theme.HushWake">
        <item name="android:windowSplashScreenBackground">@color/brand_window</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
    </style>

    <style name="Theme.HushWake.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">#121721</item>
        <item name="android:colorAccent">@color/brand_amber</item>
        <item name="android:textColorPrimary">#F6F7FA</item>
        <item name="android:textColorSecondary">#8E9BAE</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowElevation">12dp</item>
    </style>
</resources>
